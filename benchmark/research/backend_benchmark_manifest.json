  "protocol": {
    "environment_isolation": {
      "separate_worktrees": true,
      "separate_python_environments": true,
      "separate_tilelang_cache_dirs": true,
      "record_driver_compiler_torch_device_clocks": true
    },
    "correctness": {
      "reference_required": true,
      "fixed_random_seeds": [0, 1, 17, 200],
      "boundary_and_extreme_inputs_required": true,
      "compute_sanitizer_memcheck_and_racecheck_before_timing": true,
      "tolerances_are_case_specific": true,
      "unsupported_or_failed_cases_count_as_failures": true
    },
    "timing": {
      "paired_order_even": ["baseline", "candidate", "candidate", "baseline"],
      "paired_order_odd": ["candidate", "baseline", "baseline", "candidate"],
      "paired_cycles_min": 30,
      "warmup_seconds_min_per_variant_mode": 1.0,
      "sample_seconds_min_per_variant_mode": 3.0,
      "statistics": ["p50", "p90", "p99"],
      "launch_modes": ["eager", "cuda_graph"],
      "cache_modes": ["hot_l2", "cold_l2"],
      "primary_latency": "paired CUDA-event p50; CUDA Graph is a separately reported primary slice",
      "nsight_compute_wall_time_is_explanatory_only": true
    },
    "tuning": {
      "round_1": "fixed identical schedule",
      "round_2": "independent autotuning with identical candidate and wall-clock budgets",
      "record_compile_jit_and_tuning_wall_time": true,
      "cache_hit_and_cold_compile_reported_separately": true
    },
    "aggregation": {
      "speedup_definition": "baseline_p50_ms / candidate_p50_ms",
      "order": [
        "geomean repetitions into case",
        "geomean shapes and dtypes into workload family",
        "geomean families into layer",
        "geomean layers into architecture",
        "geomean required architectures into overall score"
      ],
      "equal_weight_within_each_level": true,
      "primary_layers": ["operator", "subgraph", "model", "external_suite"]
    },
    "acceptance": {
      "overall_hierarchical_geomean_min": 1.5,
      "per_required_architecture_geomean_min": 1.0,
      "per_primary_layer_geomean_min": 1.0,
      "critical_case_speedup_min": 0.97,
      "correctness_pass_fraction": 1.0,
      "required_architecture_completion_fraction": 1.0
    }
  },
