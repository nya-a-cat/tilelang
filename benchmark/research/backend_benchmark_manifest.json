  "repository": "nya-a-cat/tilelang",
  "baseline": {
    "commit": "958d6d3bd24a31874a2bb189a9791347e855eecd",
    "comparison_contract": "The baseline and candidate receive byte-identical TileLang programs, explicit schedules, inputs, output allocation, toolchain versions, and tuning budgets. Only the checked-out TileLang compiler and runtime commit changes."
  },
  "tiers": [
    {
      "id": "presubmit_static",
      "paid": false,
      "purpose": "Manifest validation, Python syntax, native unit tests, and compile-only lowering for portable targets."
    },
    {
      "id": "free_t4_screen",
      "paid": false,
      "purpose": "Early correctness and runtime rejection on a free Colab T4. Results are advisory because SM75 is outside the required main-score architectures."
    },
    {
      "id": "main_operator",
      "paid": true,
      "purpose": "Frozen operator and layout matrix on every supported required architecture."
    },
    {
      "id": "main_subgraph",
      "paid": true,
      "purpose": "Frozen multi-operator and fusion patterns on every supported required architecture."
    },
    {
      "id": "main_model",
      "paid": true,
      "purpose": "Pinned end-to-end model inference and training-step workloads."
    },
    {
      "id": "main_external_suite",
      "paid": true,
      "purpose": "Pinned independent benchmark suites and real-world workload collections."
    }
  ],
  "portable_compile_targets": [
    "sm_80",
    "sm_90",
    "sm_100",
    "sm_120",
    "gfx942"
  ],
